__pycache__/
*.py[cod]

# Map archives are deployment data and may be very large or local symlinks.
maps/*.pmtiles

# Runtime position database and SQLite sidecar files.
situation.db
situation.db-shm
situation.db-wal
situation.db-journal

# Locally generated TLS private keys and CA serial state.
caddy/certs/*.key
caddy/certs/*.srl
